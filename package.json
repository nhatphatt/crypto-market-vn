{
  "name": "crypto-market-vn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scrape": "node scripts/scrape-news.mjs",
    "prebuild": "node -e \"const fs=require('fs');if(!fs.existsSync('data/news.json')){fs.mkdirSync('data',{recursive:true});fs.writeFileSync('data/news.json',JSON.stringify({updatedAt:new Date(0).toISOString(),posts:[],sources:[]},null,2))}\"",
    "pages:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "lightweight-charts": "^5.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.119.0"
  }
}
