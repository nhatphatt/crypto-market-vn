{
  "name": "crypto-market-vn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "lint": "eslint",
    "scrape": "node scripts/scrape-news.mjs",
    "snapshot": "node scripts/fetch-markets-snapshot.mjs",
    "prebuild": "node -e \"const fs=require('fs');const p='data';if(!fs.existsSync(p))fs.mkdirSync(p,{recursive:true});if(!fs.existsSync(p+'/news.json'))fs.writeFileSync(p+'/news.json',JSON.stringify({updatedAt:new Date(0).toISOString(),posts:[],sources:[]},null,2));\"",
    "pages:deploy": "next build && wrangler pages deploy out --project-name=crypto-market-vn --commit-dirty=true",
    "deploy": "npm run pages:deploy"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "lightweight-charts": "^5.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.119.0"
  }
}
